# WSL2 global configuration — source of truth, managed by wsl-bootstrap.
# Deployed to %USERPROFILE%\.wslconfig by bootstrap.ps1 ($DeployWslConfig).
#
# Do NOT hand-edit C:\Users\<user>\.wslconfig — bootstrap overwrites it from
# this file (backing the old one up to .wslconfig.bak-<timestamp> first).
# Edit here, commit, then re-run bootstrap (or copy manually).
#
# Changes need `wsl --shutdown` to take effect, and they affect EVERY WSL2
# distro on the machine, not just the one this repo builds.
#
# POLICY: stable settings only. No [experimental] keys — that section is, by
# definition, not stable.
#
# Comments kept in English on purpose: this file is parsed by WSL itself, so
# we avoid non-ASCII in a file consumed by an external parser.

[general]
# Keep distros running with no terminal attached. Default 15000 ms: 15 s after
# the last wsl.exe client goes away the distro is terminated, taking systemd
# services with it (e.g. a chat bot run as a user service). vmIdleTimeout does not help
# here - it only keeps the VM alive, not the distro. -1 disables idle shutdown.
# Stable key: listed under [general] in learn.microsoft.com/windows/wsl/wsl-config,
# shipped in stable releases since WSL 2.5.7 (2025-04), and recommended by the
# WSL team in microsoft/WSL#13033 (with mirrored networking) and #13291.
# Cost: the VM no longer shuts down by itself, so memory goes back to Windows
# only through page reporting and dropCache (see memory= below).
instanceIdleTimeout=-1

[wsl2]
# 32GB host: cap WSL at half, leaving 16GB for Windows. Comfortable for the
# workload here (k3s + postgres/etcd/redis/nats + go/image builds, all personal
# low-concurrency testing; idle ~2-4GB, active peak ~6-10GB). Bump to 20GB if
# builds ever feel tight. The cap is the hard ceiling on what WSL can hold
# (page cache included), so it doubles as the safety net that stops WSL
# starving Windows. It is a ceiling, not a constant: pages Linux frees go back
# to Windows (free page reporting, on by default, page_reporting_order=5), and
# WSL drops the page cache by itself once the VM's user CPU has stayed under
# 0.5% for ~10 minutes - autoMemoryReclaim defaults to dropCache with no key
# set (since WSL 2.1.3; checked in the 2.6.1 source, WslCoreConfig.h).
# (An earlier version of this comment claimed memory was only freed on
# `wsl --shutdown`; that was wrong.) Large resident users are services, not
# cache - fix them at the service (2026-11: two TEI inference containers held
# ~3GB each in per-core tokenizer copies until capped in their compose file).
memory=16GB
# OOM cushion, not "bigger is better". 8GB is ample for low-concurrency testing;
# a larger swap just wastes swap.vhdx disk and invites thrashing (an OOM-killed
# test container beats the whole box grinding on 16GB of swap).
swap=8GB

# --- networkingMode: mirrored -----------------------------------------------
# Required so Windows can reach *container* ports. Measured on this machine,
# 2026-07 (container confirmed alive at test time, plain-process control):
#
#   NAT      Windows -> plain WSL process port      : OK
#            Windows -> rootless podman published   : FAILS
#            (localhostForwarding relays listeners in the WSL init netns, but
#             not the ports pasta publishes for rootless containers)
#   mirrored Windows -> rootless podman published   : OK
#
# "Use the services inside WSL from Windows without manual port-forwarding" is
# a hard requirement here, and only mirrored delivers it — so mirrored stays.
# Note networkingMode itself lives in [wsl2] (the stable section); we do NOT
# add the [experimental] hostAddressLoopback unless measurement proves it is
# actually required.
#
# Known mirrored risks to watch (WSL issue tracker, still open in 2026):
#   #13868  127.0.0.1 inside WSL cannot reach podman/docker published ports
#   #13317  rootless podman containers time out after ~3 minutes
#   #14080  a Windows update silently disabled mirrored
# These were measured on this box before adopting; re-check after WSL updates.
networkingMode=mirrored

# --- Dropped [experimental] keys --------------------------------------------
# autoMemoryReclaim / sparseVhd / hostAddressLoopback were previously present.
# All three live in [experimental]; two of them (autoMemoryReclaim, sparseVhd)
# had additionally been mis-placed under [wsl2], so WSL ignored them with
# "unknown key" warnings and they had never actually taken effect.
# Dropped rather than fixed: stable settings only.
#   - autoMemoryReclaim: also documented (WSL devblogs) to be able to break a
#     docker daemon running as a service inside WSL. Not needed anyway: with
#     no key the default is already dropCache (see memory= above); only the
#     `gradual` mode would need the key.
#   - sparseVhd: only affects newly created VHDs anyway.
#   - hostAddressLoopback: only add back if measurement shows mirrored needs it.
